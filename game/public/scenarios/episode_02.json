    {
      "type": "text",
      "speaker": "otaku",
      "text": "ありません。悪魔はそう言いました"
    },
    {
      "type": "monologue",
      "text": "沈黙。"
    },
    {
      "type": "text",
      "speaker": "osananajimi",
      "text": "……じゃあ、どうするの"
    },
    {
      "type": "monologue",
      "text": "誰も答えられない。"
    },
