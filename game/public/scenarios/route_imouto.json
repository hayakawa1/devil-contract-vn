{
  "route_imouto": [
    {
      "type": "text",
      "speaker": "",
      "text": "════ 友達の妹ルート：「お兄ちゃんの親友」 ════"
    },
    {
      "type": "bg",
      "image": "classroom"
    },
    {
      "type": "bgm",
      "file": "bgm_daily.mp3"
    },
    {
      "type": "monologue",
      "text": "ある日の放課後。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "なあ、今日うち来ない？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "急だな"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "妹がさ……お前に会いたいって"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……俺に？"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "あの体になってから、外出れなくなっててさ"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "でも、お前には会いたいんだと"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "頼む。妹、元気づけてやってくれ"
    },
    {
      "type": "bg",
      "image": "friend_house"
    },
    {
      "type": "monologue",
      "text": "親友の家。"
    },
    {
      "type": "monologue",
      "text": "リビングで待っていると、階段から彼女が降りてきた。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "imouto_neutral_flustered",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "……せ、先輩"
    },
    {
      "type": "monologue",
      "text": "ツインテールの少女。中学3年生。——でも、その体は明らかに変わっていた。"
    },
    {
      "type": "monologue",
      "text": "腕が太く、肩幅が広い。制服が、パンパンだ。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "来てくれたんですね……"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ。久しぶりだな"
    },
    {
      "type": "monologue",
      "text": "彼女は、俺の前に座った。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "あの……見ないでください。こんな体"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "見るよ"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "え"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前は俺に会いたかったんだろ。俺もお前に会いたかった"
    },
    {
      "type": "char",
      "position": "center",
      "image": "imouto_neutral_flustered",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "……っ"
    },
    {
      "type": "monologue",
      "text": "彼女の顔が、真っ赤になった。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "せ、先輩……"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "おい、なに赤くなってんだよ"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "う、うるさいお兄ちゃん！"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "はいはい"
    },
    {
      "type": "monologue",
      "text": "親友は笑った。"
    },
    {
      "type": "monologue",
      "text": "でも——俺は気づいていた。"
    },
    {
      "type": "monologue",
      "text": "彼女の目が、ずっと俺を見ていることに。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── 【友達の妹ルート 1話 完】 ────"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "════ 友達の妹ルート 2話：「兄の影」 ════"
    },
    {
      "type": "bg",
      "image": "classroom"
    },
    {
      "type": "bgm",
      "file": "bgm_tension.mp3"
    },
    {
      "type": "monologue",
      "text": "数日後。"
    },
    {
      "type": "monologue",
      "text": "親友が、深刻な顔で話しかけてきた。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "なあ、ちょっと相談があるんだけど"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "どうした"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "妹が……お前のこと、好きみたいなんだ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "前から薄々気づいてたけど、最近ひどくなってて"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "お前の名前ばっかり言うし、お前が来ると急に元気になるし"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "悪いんだけど——あいつに優しくしすぎないでくれ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……どういう意味だ"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "変な期待、持たせたくないんだ"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "あいつ、中学生だし。お前には他に——"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "頼む。傷つく前に、距離置いてくれ"
    },
    {
      "type": "bg",
      "image": "protagonist_room_night"
    },
    {
      "type": "bgm",
      "file": "bgm_sadness.mp3"
    },
    {
      "type": "monologue",
      "text": "その夜。親友の妹から連絡が来た。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "『先輩、今日来てくれないんですか？』"
    },
    {
      "type": "monologue",
      "text": "俺は——返信しなかった。"
    },
    {
      "type": "monologue",
      "text": "翌日。また連絡。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "『先輩？ 何かありましたか？』"
    },
    {
      "type": "monologue",
      "text": "返信しなかった。"
    },
    {
      "type": "monologue",
      "text": "3日後。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "『お兄ちゃんに何か言われたんですか？』"
    },
    {
      "type": "monologue",
      "text": "返信しなかった。"
    },
    {
      "type": "monologue",
      "text": "一週間後。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "『……ごめんなさい。迷惑でしたよね』"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "『もう連絡しません』"
    },
    {
      "type": "monologue",
      "text": "俺は——スマホを握りしめた。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……"
    },
    {
      "type": "monologue",
      "text": "これでいいはずだ。親友の頼みだ。彼女のためでもある。"
    },
    {
      "type": "monologue",
      "text": "でも——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……くそ"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── 【友達の妹ルート 2話 完】 ────"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "════ 友達の妹ルート 3話：「雨の中の告白」 ════"
    },
    {
      "type": "bg",
      "image": "school_gate_rain"
    },
    {
      "type": "bgm",
      "file": "bgm_sadness.mp3"
    },
    {
      "type": "monologue",
      "text": "その日、雨が降っていた。"
    },
    {
      "type": "monologue",
      "text": "放課後。校門を出ると——"
    },
    {
      "type": "monologue",
      "text": "彼女がいた。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "imouto_neutral_sad",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "……先輩"
    },
    {
      "type": "monologue",
      "text": "傘も差さずに、びしょ濡れで立っていた。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前——"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "やっと、会えました"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "帰れ。風邪ひく"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "帰りません"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "先輩、私のこと——嫌いになりましたか"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "そうじゃ——"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "じゃあ、なんで返信くれないんですか"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "お兄ちゃんに何か言われたんですよね"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "わかってます。私、子供だから。中学生だから"
    },
    {
      "type": "char",
      "position": "center",
      "image": "imouto_neutral_crying",
      "highlight": true
    },
    {
      "type": "monologue",
      "text": "涙が、雨に混じった。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "この体も気持ち悪いって、思ってますよね"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "思ってない"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "嘘です"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "嘘じゃない"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "じゃあ——"
    },
    {
      "type": "monologue",
      "text": "彼女は俺を見た。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "なんで、避けるんですか"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "私——先輩のことが、好きなんです"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "——"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "ずっと前から。先輩がうちに来るたびに、ドキドキして"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "先輩と話せる日が、楽しみで"
    },
    {
      "type": "monologue",
      "text": "涙が止まらない。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "この体になって——もう好きになってもらえないって思った"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "でも、先輩だけは——普通に接してくれた"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "だから——もっと好きになっちゃって——"
    },
    {
      "type": "monologue",
      "text": "彼女は泣いていた。雨の中、声を殺して。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "迷惑なのは、わかってます"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "中学生だし、兄の妹だし、こんな体だし"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "でも——言わないと、後悔すると思って——"
    },
    {
      "type": "monologue",
      "text": "俺は、傘を差し出した。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……入れ"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "え"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "風邪ひくって言っただろ"
    },
    {
      "type": "monologue",
      "text": "彼女は、傘の下に入った。"
    },
    {
      "type": "monologue",
      "text": "俺は、彼女の頭を撫でた。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "迷惑じゃない"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "え"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前の気持ち。迷惑だと思ったことはない"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ただ——俺は、お前の兄貴に頼まれたんだ。距離を置いてくれって"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "……お兄ちゃんが"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前を傷つけたくないから、だと"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "でも——"
    },
    {
      "type": "monologue",
      "text": "俺は彼女を見た。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "結局、傷つけてるのは俺だな"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "悪かった"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "……先輩"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "もう逃げない"
    },
    {
      "type": "char",
      "position": "center",
      "image": "imouto_neutral_smile",
      "highlight": true
    },
    {
      "type": "monologue",
      "text": "彼女の目が、潤んだ。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ちゃんと、向き合う"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── 【友達の妹ルート 3話 完】 ────"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "════ 友達の妹ルート 4話：「兄との対決」 ════"
    },
    {
      "type": "bg",
      "image": "rooftop"
    },
    {
      "type": "bgm",
      "file": "bgm_tension.mp3"
    },
    {
      "type": "monologue",
      "text": "翌日。"
    },
    {
      "type": "monologue",
      "text": "俺は親友を呼び出した。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "なんだ、急に"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "話がある"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前の妹のことだ"
    },
    {
      "type": "monologue",
      "text": "親友の顔が、険しくなった。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……何があった"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "昨日、告白された"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……断ったのか"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "断ってない"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……は？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺は——お前の妹のことが、好きだ"
    },
    {
      "type": "monologue",
      "text": "沈黙。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……お前、何言って——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "本気だ"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "待て。あいつは中学生だぞ。お前の3つ下だぞ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "知ってる"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "俺の妹だぞ！"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "知ってる"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "——っ"
    },
    {
      "type": "monologue",
      "text": "親友が、俺の胸ぐらを掴んだ。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "ふざけんな。あいつは——あいつは——"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "あの体になってから、ずっと落ち込んでた。外にも出られなくなった"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "なのに、お前が来ると笑うんだ。嬉しそうに"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "俺は——あいつを守りたいんだよ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……わかってる"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "わかってるなら——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "だから、俺が守る"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前の代わりに、俺があいつを守る"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "任せてくれ"
    },
    {
      "type": "monologue",
      "text": "沈黙。長い、長い沈黙。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……本気なんだな"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "monologue",
      "text": "親友は、俺の胸ぐらを離した。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……泣かせたら、殺す"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "わかった"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "幸せにしなかったら、殺す"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "わかった"
    },
    {
      "type": "monologue",
      "text": "親友は、天を仰いだ。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……まさか、お前に取られるとはな"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……悪い"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "謝るな。余計むかつく"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……あいつを、頼む"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── 【友達の妹ルート 4話 完】 ────"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "════ 友達の妹ルート 5話：「悪魔の取引」 ════"
    },
    {
      "type": "bg",
      "image": "protagonist_room_night"
    },
    {
      "type": "bgm",
      "file": "bgm_devil.mp3"
    },
    {
      "type": "monologue",
      "text": "その夜。"
    },
    {
      "type": "monologue",
      "text": "俺の部屋に、悪魔が現れた。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "akuma_smirk",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "お兄ちゃんの許可、もらえたんだ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……見てたのか"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "もちろん。君たちは、僕の娯楽だから"
    },
    {
      "type": "monologue",
      "text": "悪魔は笑った。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "さて、本題。一人を選ぶ時間だよ"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "七人の筋肉美女。君は誰を選ぶ？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……友達の妹を"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "ほう"
    },
    {
      "type": "monologue",
      "text": "悪魔は興味深そうに見た。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "中学生を選ぶんだ。親友の妹を"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "他の六人には、解毒剤を渡す。元の体に戻れる"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "でも、彼女だけは——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "わかってる"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "本当に？ 彼女、まだ中学生だよ。これから先、ずっとその体で生きていく"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "それでも"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "親友に、なんて説明する？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "説明する。全部"
    },
    {
      "type": "monologue",
      "text": "悪魔は、少し黙った。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "君、覚悟できてるんだね"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "monologue",
      "text": "悪魔は指を鳴らした。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "じゃあ、そういうことで"
    },
    {
      "type": "monologue",
      "text": "悪魔は消える前に、こう言った。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "彼女、幸せになれるといいね"
    },
    {
      "type": "char_exit",
      "position": "center"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── 【友達の妹ルート 5話 完】 ────"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "════ 友達の妹ルート 6話：「ずっと、隣に」 ════"
    },
    {
      "type": "bg",
      "image": "friend_house"
    },
    {
      "type": "bgm",
      "file": "bgm_romance.mp3"
    },
    {
      "type": "monologue",
      "text": "翌日。親友の家。"
    },
    {
      "type": "monologue",
      "text": "彼女を呼び出した。"
    },
    {
      "type": "monologue",
      "text": "親友は、部屋から出て行った。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……二人で話せ"
    },
    {
      "type": "char",
      "position": "center",
      "image": "imouto_neutral_surprised",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "お、お兄ちゃん……？"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "うるせー。俺は部屋にいるから"
    },
    {
      "type": "monologue",
      "text": "ドアが閉まった。"
    },
    {
      "type": "monologue",
      "text": "リビング。二人きり。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "先輩……話って"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "昨日、悪魔が来た"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺は、お前を選んだ"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "——え"
    },
    {
      "type": "monologue",
      "text": "彼女の目が、大きく見開かれた。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "他の六人には、解毒剤が渡される。元に戻れる"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "でも、お前は——"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "待ってください"
    },
    {
      "type": "monologue",
      "text": "彼女は俺を遮った。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "私を選んだ……？ 他の人じゃなくて？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "でも——私、中学生です"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "知ってる"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "お兄ちゃんの妹です"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "知ってる"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "こんな、変な体で——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "変じゃない"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前は、お前だ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺は——お前のことが、好きだ"
    },
    {
      "type": "char",
      "position": "center",
      "image": "imouto_neutral_crying",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "——っ"
    },
    {
      "type": "monologue",
      "text": "涙が、溢れた。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "う、嘘……"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "嘘じゃない"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "だって——だって——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "だって何だ"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "私、先輩に釣り合わない——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "釣り合う"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "でも——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前は、俺に会いたいって言ってくれた"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "あの体になっても、俺に会いたいって"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺は、それが嬉しかった"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "……っ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "だから——俺も、お前の隣にいたい"
    },
    {
      "type": "monologue",
      "text": "彼女は、俺の胸に飛び込んできた。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "先輩——先輩——"
    },
    {
      "type": "monologue",
      "text": "泣きながら、俺の名前を呼ぶ。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "私も——私も、先輩のことが——"
    },
    {
      "type": "char",
      "position": "center",
      "image": "imouto_neutral_smile",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "大好きです"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……ああ"
    },
    {
      "type": "monologue",
      "text": "俺は、彼女を抱きしめた。"
    },
    {
      "type": "monologue",
      "text": "小さな体。でも、筋肉質で、硬い。それでも——温かい。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "先輩……"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ん？"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "私、ずっと先輩の隣にいていいですか"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "いいに決まってる"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "大人になっても？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "ずっと、ずっと？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ずっとだ"
    },
    {
      "type": "monologue",
      "text": "彼女は笑った。涙を流しながら、笑った。"
    },
    {
      "type": "text",
      "speaker": "imouto",
      "text": "約束ですよ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ。約束だ"
    },
    {
      "type": "monologue",
      "text": "リビングに、夕日が差し込んでいた。"
    },
    {
      "type": "monologue",
      "text": "二人の影が、重なった。"
    },
    {
      "type": "monologue",
      "text": "——彼女はまだ中学生だ。"
    },
    {
      "type": "monologue",
      "text": "でも、俺は待つ。彼女が大人になるまで。"
    },
    {
      "type": "monologue",
      "text": "そして——ずっと、隣にいる。"
    },
    {
      "type": "char_exit",
      "position": "center"
    },
    {
      "type": "monologue",
      "text": "廊下で、親友がこっそり覗いていた。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……ちっ。見せつけやがって"
    },
    {
      "type": "monologue",
      "text": "でも、その顔は——少し笑っていた。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "……幸せにしろよ、バカ"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── 【友達の妹ルート 完】 ────"
    },
    {
      "type": "end"
    }
  ]
}
