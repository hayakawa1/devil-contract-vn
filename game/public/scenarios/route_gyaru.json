{
  "route_gyaru": [
    {
      "type": "text",
      "speaker": "",
      "text": "════ ギャルルート：「10万いいね」 ════"
    },
    {
      "type": "bg",
      "image": "rooftop"
    },
    {
      "type": "bgm",
      "file": "bgm_daily.mp3"
    },
    {
      "type": "monologue",
      "text": "昼休み。屋上。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "gyaru_neutral_smile",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "見てこれ"
    },
    {
      "type": "monologue",
      "text": "スマホを突きつけられた。"
    },
    {
      "type": "monologue",
      "text": "画面には、彼女の写真。——ムキムキの、ポージング写真。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前、これ——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "バズった"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "は？"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "10万いいね。まじウケる"
    },
    {
      "type": "monologue",
      "text": "笑ってる。いつもみたいに、笑ってる。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "「加工じゃないの？」とか「どこのジム？」とか、めっちゃリプきてる"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたしさ、前から思ってたんだよね。バズりたいって"
    },
    {
      "type": "monologue",
      "text": "彼女は空を見上げた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "可愛い子なんていっぱいいるじゃん。あたしより可愛い子、いくらでも"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "でもこれはさ、あたしだけじゃん。唯一じゃん"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "だから続ける。もっとバズる"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "待て。それ、バレるぞ。学校に"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "バレたら何？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "何って——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "誰も関係ないじゃん。あたしの体でしょ"
    },
    {
      "type": "monologue",
      "text": "スマホをしまう。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "ね、今度写真撮ってよ。一人じゃ限界あるし"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺が？"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "他に誰がいんの"
    },
    {
      "type": "monologue",
      "text": "じっと見てくる。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "gyaru_neutral",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……あんたに撮ってほしいの。だめ？"
    },
    {
      "type": "monologue",
      "text": "その目だけは、笑ってなかった。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── ギャルルート 2話：「炎上」 ────"
    },
    {
      "type": "bgm",
      "file": "bgm_tension.mp3"
    },
    {
      "type": "monologue",
      "text": "一週間後。"
    },
    {
      "type": "monologue",
      "text": "俺のスマホに、通知が殺到した。"
    },
    {
      "type": "monologue",
      "text": "『見て、これマジ？』『お前の学校のギャルじゃね？』『炎上してるぞ』"
    },
    {
      "type": "monologue",
      "text": "嫌な予感がした。"
    },
    {
      "type": "bg",
      "image": "rooftop"
    },
    {
      "type": "monologue",
      "text": "屋上。彼女はいた。"
    },
    {
      "type": "monologue",
      "text": "でも、いつもと違う。スマホを握りしめて、震えている。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "gyaru_neutral",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "おい"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……見た？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "何を"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "まとめサイト。『筋肉JK、学校バレで大炎上』"
    },
    {
      "type": "monologue",
      "text": "彼女はスマホを見せた。画面には、大量のコメント。"
    },
    {
      "type": "monologue",
      "text": "『キモすぎ』『加工かと思ったらガチかよ』『同じ学校とか終わってる』『奇形じゃん』『見世物小屋かな？』"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "学校の名前、バレた"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "匿名掲示板に、校門の写真貼られてた"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "誰が——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "知らない。同じ学校の誰か"
    },
    {
      "type": "monologue",
      "text": "彼女は笑った。いつもの笑顔。でも、目が死んでいる。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "まじウケる。あたしのアンチ、もう3万人いるんだって"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "笑えねえだろ"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "笑えるよ。だって——"
    },
    {
      "type": "monologue",
      "text": "声が震えた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "笑ってないと、泣いちゃうから"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "明日から学校、どうしよ"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "親にも連絡行くかな。『お宅の娘さんがネットで——』って"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "やばいよね。まじでやばい"
    },
    {
      "type": "monologue",
      "text": "彼女は空を見上げた。"
    },
    {
      "type": "bgm",
      "file": "bgm_sadness.mp3"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……助けて"
    },
    {
      "type": "monologue",
      "text": "小さな声だった。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "誰か、助けて"
    },
    {
      "type": "monologue",
      "text": "俺は——何も言えなかった。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── ギャルルート 3話：「夜のファミレス」 ────"
    },
    {
      "type": "bg",
      "image": "black"
    },
    {
      "type": "monologue",
      "text": "その夜。彼女から連絡が来た。"
    },
    {
      "type": "monologue",
      "text": "『今どこ？ 会いたい』"
    },
    {
      "type": "monologue",
      "text": "駅前のファミレス。深夜1時。"
    },
    {
      "type": "bg",
      "image": "family_restaurant_night"
    },
    {
      "type": "monologue",
      "text": "店内はガラガラだった。"
    },
    {
      "type": "monologue",
      "text": "奥の席に、彼女がいた。すっぴん。メイクしてない彼女を見るのは初めてだ。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "gyaru_neutral",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……来てくれた"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "当たり前だろ"
    },
    {
      "type": "monologue",
      "text": "向かいに座る。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……家、出てきちゃった"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "は？"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "お母さんと喧嘩して"
    },
    {
      "type": "monologue",
      "text": "彼女はドリンクバーのコーラを見つめた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "『あんた何やってんの』『恥ずかしい』『普通の子に戻りなさい』"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "普通って何。あたしずっと普通だったじゃん"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "普通に可愛くて、普通に目立って、普通にいいね貰って"
    },
    {
      "type": "monologue",
      "text": "彼女の目が、揺れた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "でも、それじゃ足りなかった"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "足りない？"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたしね、中学の頃——"
    },
    {
      "type": "monologue",
      "text": "彼女は言葉を切った。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "いじめられてた"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "地味で、暗くて、誰にも見てもらえなくて"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "高校入って、ギャルになった。派手にして、目立つようにして"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "そしたらみんな、あたしを見てくれた"
    },
    {
      "type": "monologue",
      "text": "彼女は笑った。泣きそうな顔で。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "見てもらえるのが、嬉しかった"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "だからSNSも頑張った。フォロワー増やして、いいね貰って"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "でも——"
    },
    {
      "type": "monologue",
      "text": "彼女は自分の腕を見た。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "この体になって、もっと見てもらえると思った"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "唯一になれるって。誰にも真似できない存在になれるって"
    },
    {
      "type": "monologue",
      "text": "涙が、こぼれた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "なのに——こんなの——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたし、間違えた？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "間違えてない"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "でも——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "見てもらいたいって気持ちは、間違いじゃない"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ただ、見る相手を間違えただけだ"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "見る相手……？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "匿名の誰かじゃなくて——"
    },
    {
      "type": "monologue",
      "text": "俺は、彼女を見た。"
    },
    {
      "type": "bgm",
      "file": "bgm_romance.mp3"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺は、ずっと見てる"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "メイクしてようがしてなかろうが。筋肉があろうがなかろうが"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前は、お前だ"
    },
    {
      "type": "monologue",
      "text": "涙が止まらなくなった。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "ずるい……そんなの、ずるい……"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "今更そんなこと言われても——"
    },
    {
      "type": "monologue",
      "text": "彼女は泣いた。ファミレスの奥で、声を殺して泣いた。"
    },
    {
      "type": "monologue",
      "text": "俺はただ、隣にいた。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── ギャルルート 4話：「10万人の敵」 ────"
    },
    {
      "type": "bg",
      "image": "school_gate"
    },
    {
      "type": "bgm",
      "file": "bgm_tension.mp3"
    },
    {
      "type": "monologue",
      "text": "翌日。学校。"
    },
    {
      "type": "monologue",
      "text": "校門の前に、人だかりができていた。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "なにあれ……"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "まじかよ……"
    },
    {
      "type": "monologue",
      "text": "俺は人混みをかき分けた。"
    },
    {
      "type": "monologue",
      "text": "そして——見た。"
    },
    {
      "type": "monologue",
      "text": "校門に、彼女の写真が貼られていた。大量に。何十枚も。"
    },
    {
      "type": "monologue",
      "text": "『筋肉女』『出ていけ』『学校の恥』"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "誰がこんな——"
    },
    {
      "type": "char",
      "position": "center",
      "image": "gyaru_neutral",
      "highlight": true
    },
    {
      "type": "monologue",
      "text": "彼女は、校門の前に立っていた。無表情で、それを見ていた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あー"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "おい——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "やっぱこうなるよね"
    },
    {
      "type": "monologue",
      "text": "彼女は写真を一枚、剥がした。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "ネットだけじゃ飽き足らず、リアルまで来たか"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "警察に——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "無駄無駄。匿名の誰かでしょ、こんなの"
    },
    {
      "type": "monologue",
      "text": "彼女は笑った。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "10万人のフォロワーがいて、3万人のアンチがいて"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "その中の誰か一人が、これをやった"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "見つけられるわけないじゃん"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "ね、わかった？"
    },
    {
      "type": "monologue",
      "text": "彼女は俺を見た。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "これがあたしの「人気」の正体"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "見てもらえる代わりに、憎まれる"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "目立つ代わりに、叩かれる"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたし、もう——"
    },
    {
      "type": "monologue",
      "text": "そのとき。"
    },
    {
      "type": "bgm",
      "file": "bgm_daily.mp3"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "おい"
    },
    {
      "type": "monologue",
      "text": "声がした。"
    },
    {
      "type": "monologue",
      "text": "振り返ると——筋肉同好会のメンバーが立っていた。"
    },
    {
      "type": "text",
      "speaker": "osananajimi",
      "text": "手伝う"
    },
    {
      "type": "text",
      "speaker": "seitokai",
      "text": "写真、全部剥がしましょう"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "証拠として、撮影しておきます"
    },
    {
      "type": "text",
      "speaker": "kakutogi",
      "text": "誰がやったか。見つけたら、覚悟しろよ"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "え——なんで——"
    },
    {
      "type": "text",
      "speaker": "osananajimi",
      "text": "仲間でしょ"
    },
    {
      "type": "text",
      "speaker": "seitokai",
      "text": "筋肉同好会は、互いを守ります"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "データは力です。必ず犯人を特定しましょう"
    },
    {
      "type": "text",
      "speaker": "kakutogi",
      "text": "……まあ、放っておけないだろ"
    },
    {
      "type": "monologue",
      "text": "涙が、溢れた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "バカじゃん……みんな……"
    },
    {
      "type": "text",
      "speaker": "osananajimi",
      "text": "バカで結構"
    },
    {
      "type": "text",
      "speaker": "seitokai",
      "text": "さあ、始めましょう"
    },
    {
      "type": "monologue",
      "text": "みんなで、写真を剥がし始めた。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前は、一人じゃない"
    },
    {
      "type": "char",
      "position": "center",
      "image": "gyaru_neutral_smile",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……うん"
    },
    {
      "type": "monologue",
      "text": "彼女は泣きながら、笑った。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……ありがと"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── ギャルルート 5話：「悪魔の取引」 ────"
    },
    {
      "type": "bg",
      "image": "protagonist_room_night"
    },
    {
      "type": "bgm",
      "file": "bgm_devil.mp3"
    },
    {
      "type": "monologue",
      "text": "その夜。俺の部屋に、あいつが現れた。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "akuma_smirk",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "大変だったね"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……お前"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "炎上、誹謗中傷、嫌がらせ。彼女、かわいそう"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "黙れ"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "でも、これは君のせいじゃないよ"
    },
    {
      "type": "monologue",
      "text": "悪魔はにこりと笑った。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "彼女自身が、選んだ道だから"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "さて、本題。一人を選ぶ時間だよ"
    },
    {
      "type": "monologue",
      "text": "悪魔は宙に浮かんだ。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "七人の筋肉美女。君は誰を選ぶ？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……ギャルを"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "ほう"
    },
    {
      "type": "monologue",
      "text": "悪魔は興味深そうに見た。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "彼女を選ぶんだ。炎上中の、あの子を"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "他の六人には、解毒剤を渡す。元の体に戻れる"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "でも、彼女は戻れない。一生、その体のまま"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "わかってる"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "わかってるの？ ネットの中傷は、永遠に続くよ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "それでも"
    },
    {
      "type": "monologue",
      "text": "悪魔は、珍しく黙った。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "君、本気なんだね"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "面白い"
    },
    {
      "type": "monologue",
      "text": "悪魔は指を鳴らした。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "じゃあ、そういうことで"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "彼女、喜ぶといいね。……喜ぶかな"
    },
    {
      "type": "char_exit",
      "position": "center"
    },
    {
      "type": "monologue",
      "text": "その言葉の意味は、すぐにわかった。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── ギャルルート 6話：『本当の「いいね」』 ────"
    },
    {
      "type": "bg",
      "image": "rooftop"
    },
    {
      "type": "bgm",
      "file": "bgm_romance.mp3"
    },
    {
      "type": "monologue",
      "text": "翌日。屋上。"
    },
    {
      "type": "monologue",
      "text": "彼女を呼び出した。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "gyaru_neutral",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "なに、話って"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "昨日、悪魔が来た"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺は、お前を選んだ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "他の六人には、解毒剤が渡される。元に戻れる"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……え"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "でも、お前は——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "待って"
    },
    {
      "type": "monologue",
      "text": "彼女は俺を遮った。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたしだけ、戻れないってこと？"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ああ"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……なんで"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "なんでって——"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "なんで、あたしを選んだの"
    },
    {
      "type": "monologue",
      "text": "彼女の目が、揺れていた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたし、ネットで叩かれてる。リアルでも嫌がらせされてる"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "こんな体で、一生——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前が好きだからだ"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "炎上してようが、叩かれてようが。関係ない"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "お前が10万いいね貰おうが、10万アンチがいようが"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺の気持ちは変わらない"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺は、お前を見てる。ずっと見てる"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "それじゃ、足りないか？"
    },
    {
      "type": "monologue",
      "text": "彼女は、泣いていた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "足りるわけないじゃん"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "え"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "たった一人の「いいね」で、足りるわけ——"
    },
    {
      "type": "monologue",
      "text": "彼女は俺の胸に飛び込んできた。"
    },
    {
      "type": "char",
      "position": "center",
      "image": "gyaru_neutral_smile",
      "highlight": true
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "——足りるに決まってんじゃん、バカ"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたしが欲しかったの、こっちだから"
    },
    {
      "type": "monologue",
      "text": "彼女は泣きながら、笑った。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "誰かに見てもらいたかったんじゃない"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あんたに見てもらいたかったの"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "最初から、ずっと"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……ああ"
    },
    {
      "type": "monologue",
      "text": "俺は、彼女を抱きしめた。"
    },
    {
      "type": "monologue",
      "text": "筋肉質の、硬い体。でも、震えている。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたしね、SNS——"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "ん？"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "もうやめる。フォロワーとか、いいねとか"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "いいのか？"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "うん"
    },
    {
      "type": "monologue",
      "text": "彼女は俺を見上げた。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "だって、あんたがいるじゃん"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あんたの「いいね」が、あれば——"
    },
    {
      "type": "monologue",
      "text": "彼女は笑った。今度は、本当の笑顔で。"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "あたし、それだけで生きていける"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……大げさだな"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "大げさじゃないし"
    },
    {
      "type": "text",
      "speaker": "gyaru",
      "text": "……好き"
    },
    {
      "type": "monologue",
      "text": "小さく、そう言った。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺も"
    },
    {
      "type": "monologue",
      "text": "屋上で、二人の影が重なった。"
    },
    {
      "type": "monologue",
      "text": "風が吹いた。彼女の髪が揺れた。"
    },
    {
      "type": "monologue",
      "text": "どこかで、悪魔が笑っている気がした。"
    },
    {
      "type": "monologue",
      "text": "でも——もう、関係ない。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "──── 【ギャルルート 完】 ────"
    },
    {
      "type": "end"
    }
  ]
}
