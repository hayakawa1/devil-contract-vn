{
  "route_otaku_start": [
    {
      "type": "text",
      "speaker": "",
      "text": "■ オタクルート「被験体」"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "テーマ：好奇心 / 知の暴力 / 自己実験"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "第1話「仮説が立った」"
    },
    {
      "type": "bg",
      "image": "理科準備室・放課後"
    },
    {
      "type": "bgm",
      "file": "静音"
    },
    {
      "type": "monologue",
      "text": "黒板に数式とメモ。"
    },
    {
      "type": "monologue",
      "text": "彼女は白衣の袖をまくっている。"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "……やっぱり"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "なにが"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "筋肉化、\n単なる成長ホルモンじゃない"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……最初から言ってたな"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "代謝速度が異常"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "筋繊維の再構築が、\n\"意思\"に反応してる"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……意思？"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "そう"
    },
    {
      "type": "monologue",
      "text": "彼女は自分の腕を見る。"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "私が\"動かそう\"と思う前に、\n体が先に準備してる"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……怖くないのか"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "怖い"
    },
    {
      "type": "monologue",
      "text": "即答。"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "だから、調べる"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "第2話「同意書」"
    },
    {
      "type": "bg",
      "image": "空き教室"
    },
    {
      "type": "bgm",
      "file": "紙の擦れる音"
    },
    {
      "type": "monologue",
      "text": "紙を差し出される。"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……同意書？"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "うん"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "誰の"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "私の"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "実験対象：私"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "実験責任者：私"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……お前"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "倫理委員会、私"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "最悪だな"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "最善だよ"
    },
    {
      "type": "monologue",
      "text": "真顔。"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "他人を使わない"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "自分なら、壊れても納得できる"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "俺は？"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "……"
    },
    {
      "type": "monologue",
      "text": "少し間。"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "観測者"
    },
    {
      "type": "monologue",
      "text": "その言葉が、少しだけ冷たい。"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "第3話「最初のデータ」"
    },
    {
      "type": "bg",
      "image": "理科準備室・夜"
    },
    {
      "type": "bgm",
      "file": "機械音（低）"
    },
    {
      "type": "monologue",
      "text": "ストップウォッチ。"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "筋力、\n通常女子平均の約3.8倍"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "でも面白いのは、ここ"
    },
    {
      "type": "monologue",
      "text": "グラフを見せる。"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "疲労回復曲線"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "普通なら下降するのに、\n一度、跳ね返ってる"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "つまり"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "\"限界\"を越えると、\n体が\"報酬\"を出す"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……やめとけ"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "やめたら、分からない"
    },
    {
      "type": "monologue",
      "text": "目が光る。"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "分からないまま戻るくらいなら"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "壊れた方が、意味がある"
    },
    {
      "type": "monologue",
      "text": "その瞬間、\n悪魔の存在が\"理解可能な形\"で現れる。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "いい仮説だね"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "……誰"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "……来たか"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "私は、外部変数"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "君の研究を、少しだけ進められる"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "……条件は"
    },
    {
      "type": "monologue",
      "text": "即、聞く。"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "観測を続けること"
    },
    {
      "type": "text",
      "speaker": "akuma",
      "text": "途中で、\"怖い\"と言わないこと"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "……"
    },
    {
      "type": "text",
      "speaker": "protagonist",
      "text": "やめろ"
    },
    {
      "type": "text",
      "speaker": "otaku",
      "text": "……協力しないなら、邪魔しないで"
    },
    {
      "type": "text",
      "speaker": "",
      "text": "★ 分岐ポイントA：研究の方向性"
    },
    {
      "type": "choice",
      "choices": [
        {
          "label": "解毒剤開発（科学ルート）",
          "next": "分岐A_科学ルート"
        },
        {
          "label": "筋肉研究（マッドサイエンス）",
          "next": "分岐A_マッドサイエンス"
        }
      ]
    }
  ]
}
